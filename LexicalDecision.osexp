	set description "Logs experimental data"
	set auto_log no
	log Practice
	log accuracy
	log block
	log correct
	log correct_keyboard_response
	log experiment_path
	log fixation_dur
	log keyboard_backend
	log mouse_backend
	log response_keyboard_response
	log response_time_keyboard_response
	log subject_nr
	log time_block_start
	log time_end_of_experiment
	log time_end_of_block_trigger
	log time_end_of_practice_block_trigger
	log time_experiment
	log time_experimental_block
	log time_experimental_sequence
	log time_feedback
	log time_fixation
	log time_fixation_duration
	log time_generalpreps
	log time_keyboard_response
	log time_Experimental
	log time_Practice
	log time_main_instructions
	log time_new_block
	log time_new_block_trigger
	log time_new_sketchpad
	log time_practice_block
	log time_practice_block_trigger
	log time_practice_sequence_1
	log time_practice_start
	log time_presstostart
	log time_response_trigger
	log time_stimulus
	log time_stimulus_trigger
	log time_trial_sequence
	log title
	log RT
	log stimulus
	log condition
	log cond
	log correct_response
	log data_row_type
	log adaptive_phase
	log adaptive_category
	log exposure_time_before
	log exposure_time_after
	log step_size_before
	log step_size_applied
	log step_size_after
	log outcome_history_before
	log outcome_history_after
	log alternation_detected
	log response_was_timeout
	log adaptive_change
	log exposure_floor_reached
	log exposure_HF
	log exposure_LF
	log exposure_Pseudo
	log exposure_Random
	log step_HF
	log step_LF
	log step_Pseudo
	log step_Random
	log history_HF
	log history_LF
	log history_Pseudo
	log history_Random

define sketchpad main_instructions
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=black font_bold=no font_family=mono font_italic=no font_size=20 html=yes show_if=always text="Welkom!<br /><br />In dit experiment is het de bedoeling dat je beoordeelt of een woord een<br />echt Nederlands woord (stoel) of een nep-woord (estol) is.<br /><br />Je gaat dit eerste even oefenen; daarna krijg je <br />vier blokken met het echte experiment.<br /><br /><br />Druk op een toets om door te gaan naar de oefensessie." x=0 y=0 z_index=0

define inline_script new_block
	set description "Executes Python code"
	set _run ""
	___prepare__
	var.block = var.block + 1
	var.adaptive_phase = 'experimental'
	var.data_row_type = 'setup'
	var.exposure_HF = 2000
	var.exposure_LF = 2000
	var.exposure_Pseudo = 2000
	var.exposure_Random = 2000
	var.step_HF = 50
	var.step_LF = 50
	var.step_Pseudo = 50
	var.step_Random = 50
	var.history_HF = ''
	var.history_LF = ''
	var.history_Pseudo = ''
	var.history_Random = ''
	__end__

define inline_script reset_practice_adaptive_timers
	set description "Resets the four adaptive timers for practice"
	___run__
	var.adaptive_phase = 'practice'
	var.data_row_type = 'setup'
	var.exposure_HF = 2000
	var.exposure_LF = 2000
	var.exposure_Pseudo = 2000
	var.exposure_Random = 2000
	var.step_HF = 50
	var.step_LF = 50
	var.step_Pseudo = 50
	var.step_Random = 50
	var.history_HF = ''
	var.history_LF = ''
	var.history_Pseudo = ''
	var.history_Random = ''
	__end__
	set _prepare ""

define inline_script prepare_adaptive_trial
	set description "Selects the adaptive timer for the current category"
	set _run ""
	___prepare__
	category = str(var.cond)
	var.data_row_type = 'trial'
	var.adaptive_category = category
	var.alternation_detected = 0
	var.response_was_timeout = 0
	var.adaptive_change = 0
	var.exposure_floor_reached = 0
	
	if category == 'HF':
		var.exposure_time_before = var.exposure_HF
		var.step_size_before = var.step_HF
		var.outcome_history_before = var.history_HF
	elif category == 'LF':
		var.exposure_time_before = var.exposure_LF
		var.step_size_before = var.step_LF
		var.outcome_history_before = var.history_LF
	elif category == 'Pseudo':
		var.exposure_time_before = var.exposure_Pseudo
		var.step_size_before = var.step_Pseudo
		var.outcome_history_before = var.history_Pseudo
	elif category == 'Random':
		var.exposure_time_before = var.exposure_Random
		var.step_size_before = var.step_Random
		var.outcome_history_before = var.history_Random
	else:
		raise ValueError('Unknown adaptive category: {}'.format(category))
	
	var.exposure_time_after = var.exposure_time_before
	var.step_size_applied = var.step_size_before
	var.step_size_after = var.step_size_before
	var.outcome_history_after = var.outcome_history_before
	__end__

define inline_script prepare_adaptive_summary
	set description "Marks an end-of-block adaptive summary row"
	___run__
	var.data_row_type = 'block_summary'
	var.adaptive_category = 'ALL'
	__end__
	set _prepare ""

define inline_script new_block_trigger
	set description "Executes Python code"
	___run__
	if eeg:
		trigger = 4
		try: 
			io.DlPortWritePortUchar(port, trigger)
			print "Trigger number {} NEW BLOCK TRIGGER".format(trigger)
		except:
			print 'Failed to send trigger!'
		self.sleep(2)
		io.DlPortWritePortUchar(port, 0) 
	__end__
	set _prepare ""

